# Copy to backend/.env and adjust as needed. All variables use the
# SENTINELML_ prefix (see app/core/config.py) and are optional -- every
# one has a sensible default for local development.

# Shown in GET /health and the OpenAPI title.
# SENTINELML_APP_NAME=SentinelML

# Free-text; shown in GET /health. Set to something like "production" or
# "staging" to distinguish deployments in logs/monitoring.
# SENTINELML_ENVIRONMENT=development

# Python logging level for the root logger (DEBUG, INFO, WARNING, ERROR).
# SENTINELML_LOG_LEVEL=INFO

# URL prefix every route is mounted under.
# SENTINELML_API_V1_PREFIX=/api/v1

# JSON array of allowed CORS origins. Only matters when the frontend and
# backend are served from different origins (e.g. a separately hosted SPA
# calling this API directly) -- the Vite dev proxy and the Docker nginx
# reverse proxy both make requests same-origin, so CORS isn't exercised in
# either of those setups.
# SENTINELML_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Root directory ModelRegistry resolves versions from (expects a
# `preprocessing/` subdirectory plus one or more `vN/` version
# subdirectories -- see ml/models/registry.py). Relative paths are
# anchored to backend/, not the process's working directory.
# SENTINELML_MODEL_REGISTRY_PATH=../ml/models/artifacts

# Pin a specific trained-model version (e.g. "v1") instead of always
# resolving to the latest one under MODEL_REGISTRY_PATH. Leave unset to
# always serve the most recently trained model.
# SENTINELML_MODEL_VERSION=
