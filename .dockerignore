# Used when building backend/Dockerfile with the repo root as context.
.git
.github

.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.cohort
.claude

# Frontend isn't part of the backend image.
frontend/node_modules
frontend/dist

# Large/binary and not needed to run a deployment -- not baked into the
# image. ml/models/artifacts is deliberately NOT listed here: it's
# committed (see .gitignore) and does need to be in the build context so
# backend/Dockerfile can COPY it in.
ml/data/raw
ml/data/processed
docs/reports/figures

.env
.env.*
!.env.example
*.log
.DS_Store
