# Copy to .env and adjust as needed. `docker compose` loads this file
# automatically (no `env_file:` directive needed) -- see docker-compose.yml
# for how each variable is used. All are optional; the compose file's own
# defaults match backend/.env.example and frontend/.env.example.

# Host ports the stack is published on.
# BACKEND_PORT=8000
# FRONTEND_PORT=8080

# Passed through to the backend container (see backend/.env.example for
# the full list of SENTINELML_* variables the app understands).
# SENTINELML_ENVIRONMENT=docker-compose
# SENTINELML_LOG_LEVEL=INFO
# SENTINELML_MODEL_VERSION=

# JSON array -- only needed if something other than the dockerized
# frontend (which talks to the backend same-origin, via nginx) calls this
# API directly from a browser. Must be valid JSON if set at all.
# SENTINELML_CORS_ALLOW_ORIGINS=["https://example.com"]

# Baked into the frontend image at build time (Vite env vars are
# compile-time, not runtime) -- only needed if the API is hosted at a
# different origin than the dashboard itself. Leave unset for the default
# same-origin nginx proxy setup docker-compose.yml uses.
# VITE_API_BASE_URL=
